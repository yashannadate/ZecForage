# ZecForge Server Environment Configuration
# Webhook HMAC-SHA256 Signing Secret
# Generate a secure 32+ byte hex key (e.g., `openssl rand -hex 32`)
ZECFORGE_WEBHOOK_SECRET=your_32_byte_hex_secret_here

# Default Confirmation Policy (demonstration risk threshold, default: 10)
ZECFORGE_CONFIRMATION_THRESHOLD=10
